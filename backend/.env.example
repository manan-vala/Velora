# Required
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/velora
OSRM_URL=http://localhost:5000
SECRET_KEY=
# The account that manages users; created on startup, password rotated if you change it here
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

# Optional tuning (defaults shown)
# JWT_EXPIRE_MINUTES=1440
# SOLVER_MAX_WORKERS=1
# SOLVER_TIME_LIMIT_S=40
# SOLVER_GRACE_S=30
# MAX_PENDING_JOBS=5
# JOB_RESULT_TTL_S=3600
# OSRM_TABLE_BLOCK=100
